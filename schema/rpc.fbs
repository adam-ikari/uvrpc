// UVRPC RPC Schema
// FlatBuffers schema for RPC messages with frame type support

namespace uvrpc;

enum RpcFrameType:uint8 {
  Error = 0,
  Request = 1,
  Response = 2,
  Stream = 3
}

// Frame wrapper
table RpcFrame {
  type: RpcFrameType;
  msgid: uint32;
  method: string;
  params: [ubyte];
  status: uint32;
  error_message: string;
  result: [ubyte];
  is_last_chunk: bool = false;
}

root_type RpcFrame;
