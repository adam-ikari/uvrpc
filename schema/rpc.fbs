namespace uvrpc;

/* ============================================================
   UVRPC Core Frame Definition
   Used for all RPC communication
   ============================================================ */

table RpcFrame {
    type: int32;          /* 0=request, 1=response, 2=notification, 3=error */
    msgid: uint32;        /* Message ID */
    method: string;       /* Method name (for requests) */
    params: [ubyte];      /* Parameters or result data */
}

root_type RpcFrame;