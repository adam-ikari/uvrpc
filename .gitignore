# Build directories
build/
dist/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
# Hand-written CMake modules must be tracked (the bare *.cmake rule above
# silently excluded cmake/Dependencies.cmake, breaking fresh clones).
!cmake/
!cmake/*.cmake

# Generated files
examples/*_generated.h
generated/
gen_benchmark

# Object files
*.o
*.so
*.dylib
libmsgpackc.a

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files
*.bak
*.orig

# OS files
.DS_Store
Thumbs.db

# Dependency build directories (submodules)
# (anchored to root: the unanchored form also matched deps/mimalloc and made
# git refuse to track the submodule)
/mimalloc/
deps/*/build/
deps/flatcc/bin/
deps/flatcc/lib/
deps/flatcc/include/
deps/flatcc/share/

# Stale example binaries accidentally committed at repo root
/scenario_*

# OMC plugin state
.omc/

# Python
__pycache__/
*.egg-info/
*.pyc
*.pyo

# Documentation site build artifacts (installed/built locally, not committed)
docs/node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
